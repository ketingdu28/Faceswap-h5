# ═══════════════════════════════════════════════════════════════════════════════
# xmeta-agent-h5 — 环境变量完整说明
# ═══════════════════════════════════════════════════════════════════════════════
#
# 本地开发：复制本文件为 .env.local，填写真实值后重启 dev server（Ctrl+C → npm run dev）
# 生产部署：在 Vercel Dashboard → Project Settings → Environment Variables 逐项添加
#
# ⚠ 重要：.env 和 .env.local 均被 .gitignore 排除，Vercel 构建时不会读取。
#          所有生产环境变量必须通过 Vercel 控制台单独配置，否则回退到代码内置默认值。
# ⚠ 安全：所有 VITE_ 前缀变量均会被 Vite 打包进客户端 JS，用户可在浏览器中查看。
#          请勿存放高权限密钥；建议在 API 平台侧限制 Key 的请求来源和调用额度。
#
# ═══════════════════════════════════════════════════════════════════════════════


# ── 1. 核心运行模式 ────────────────────────────────────────────────────────────

# 应用功能模式：FULL = 完整功能（换脸 + 证书）| TEASER = 预告模式（隐藏下载入口）
VITE_APP_MODE=FULL

# 换脸服务来源：mock = 本地模拟（无需后端，适合 UI 联调）| cloud = 接入真实 AI 服务
VITE_API_MODE=cloud

# cloud 模式下的 AI 提供商（VITE_API_MODE=cloud 时生效）：
#   jimeng  — 即梦 / Doubao Seedream（火山引擎 Ark）推荐，国内访问优化
#   piapi   — PiAPI 直连（⚠ API Key 暴露在前端，仅限开发 / 内网）
#   backend — 自建 HTTP 后端（API Key 由服务端持有，推荐生产使用）
#   invoker — 微信小程序 WebView 注入的云函数桥（window.__XmetaCloudInvoke）
VITE_CLOUD_PROVIDER=jimeng


# ── 2. 姿势引导层（PoseGuide） ──────────────────────────────────────────────────

# 1 = 拍照前启用姿势引导相机 | 0 = 关闭（直接进入上传流程）
VITE_POSE_GUIDE=1

# 1 = 调试模式：打开姿势引导界面但不启用摄像头（用于界面走查）
VITE_POSE_GUIDE_DEBUG_NO_CAMERA=0


# ── 3. ImgBB 图片托管（所有 cloud 模式均需要） ────────────────────────────────
#
# 用户照片和模板图须先上传至 ImgBB（公网 CDN），AI 接口才能访问。
# 免费 Key 申请：https://api.imgbb.com/
# 图片将被压缩到 1280px 以内再上传，避免大图导致上传超时。

VITE_IMGBB_KEY=your_imgbb_api_key_here


# ── 4. 即梦 / Doubao Seedream（VITE_CLOUD_PROVIDER=jimeng） ───────────────────
#    火山引擎 Ark 接口，国内 CDN 优化，推荐用于生产环境

# 4-1  基础配置
# ─────────────────────────────────────────────────────────────────────────────

# API 代理路径：本地 dev 使用 Vite 反代（/jimeng-proxy），生产由 Vercel rewrite 处理
VITE_JIMENG_BASE_URL=/jimeng-proxy

# 火山引擎 Ark API Key（格式：ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxxx）
# 申请地址：https://console.volcengine.com/ark
VITE_JIMENG_API_KEY=your_ark_api_key_here

# 即梦模型 ID，通常无需修改
VITE_JIMENG_MODEL=doubao-seedream-5-0-260128

# 换脸输出分辨率：1024x1024（快）| 2k（高清，约 30-60s）| 4k（超清，较慢）
VITE_JIMENG_SIZE=2k

# 接口超时（毫秒），即梦图片生成耗时较长，建议 ≥ 90000
VITE_JIMENG_TIMEOUT_MS=120000

# 4-2  换脸提示词（可选覆盖，留空则使用代码内置默认值）
# ─────────────────────────────────────────────────────────────────────────────

VITE_JIMENG_PROMPT=


# 4-3  AI 换脸高清底图（9 张，对应选择器 A1-A3 / B1-B3 / C1-C3）
# ─────────────────────────────────────────────────────────────────────────────
# 上传到 ImgBB 后填入 Direct link（https://i.ibb.co/…/image.png）。
# 未填则自动降级：使用本地预览缩略图，在换脸请求时实时上传 ImgBB。
# ⚠ 即梦服务器在国内，不能访问 Vercel / localhost 等域名，必须使用可被国内访问的 CDN URL。

VITE_AI_TEMPLATE_A1=
VITE_AI_TEMPLATE_A2=
VITE_AI_TEMPLATE_A3=
VITE_AI_TEMPLATE_B1=
VITE_AI_TEMPLATE_B2=
VITE_AI_TEMPLATE_B3=
VITE_AI_TEMPLATE_C1=
VITE_AI_TEMPLATE_C2=
VITE_AI_TEMPLATE_C3=


# 4-4  游戏证书生成（AI 一体化模式：皮克斯头像生成 + 证书融合，单次 API 完成）
# ─────────────────────────────────────────────────────────────────────────────
# ⚠ 证书模板必须托管在国内可访问的 CDN（阿里云 OSS / 腾讯 COS / 七牛云等）。
#   ImgBB（ibb.co）在国内访问不稳定，即梦服务器无法可靠拉取，请勿使用。
# 留空则降级为 Canvas 本地合成模式（不调用 AI，直接叠图）。

# 证书模板图公网 URL（国内 CDN，空 = 降级 Canvas 合成）
VITE_CERTIFICATE_TEMPLATE_URL=

# 证书输出尺寸（独立于换脸 SIZE，应与证书模板比例一致）
VITE_JIMENG_CERT_SIZE=1882x3344

# 无蒙版时的一体化提示词（留空用代码内置默认值）
VITE_JIMENG_CERT_ONE_SHOT_PROMPT=

# 蒙版图路径，用于精确保护证书文字区域（留空 = 不使用蒙版，依赖提示词保护）：
#   - /cert-mask.png          → public/ 下的相对路径，自动 fetch 后上传 ImgBB
#   - https://cdn.example/... → 已托管的完整公网 URL，即梦可直接访问
VITE_JIMENG_CERT_MASK_URL=

# 有蒙版时的 inpainting 提示词（留空用代码内置默认值）
VITE_JIMENG_CERT_INPAINT_PROMPT=


# ── 5. 场景滤镜（Canvas 烘焙，预览和下载均生效） ──────────────────────────────
#
# 值为百分比整数：100 = 不变 | >100 增强 | <100 减弱（建议范围见括号）
# 代码内置默认值：SATURATE=135 CONTRAST=105 BRIGHTNESS=100（与下方一致）
# ⚠ 修改后本地须重启 dev server；生产须在 Vercel Dashboard 中配置。

VITE_SCENE_FILTER_SATURATE=135
VITE_SCENE_FILTER_CONTRAST=105
VITE_SCENE_FILTER_BRIGHTNESS=100


# ── 6. PiAPI 直连（VITE_CLOUD_PROVIDER=piapi，备用） ──────────────────────────
#    ⚠ API Key 会打包进前端 JS，任何人可见；仅推荐用于开发 / 内网测试

VITE_PIAPI_BASE_URL=https://api.piapi.ai
VITE_PIAPI_ENDPOINT=/api/v1/task
VITE_PIAPI_MODEL=Qubico/image-toolkit
VITE_PIAPI_API_KEY=your_piapi_key_here

# 若 PiAPI 返回结构变更，通过点路径指定结果图字段，例如 output.image_url
VITE_PIAPI_RESULT_PATH=


# ── 7. Backend HTTP 自建后端（VITE_CLOUD_PROVIDER=backend） ──────────────────
#    API Key 由服务端持有，前端无需配置 AI Key，推荐生产环境使用
#
# 后端需实现 submit / poll 协议（与云函数 faceSwapAction 接口一致）：
#   POST /faceSwapAction  { action:'submit', swapImageUrl, targetImageUrl }
#                         → { success:true, taskId }
#   POST /faceSwapAction  { action:'poll',   taskId }
#                         → { success:true, status:'completed', imageUrl }

VITE_CLOUD_BASE_URL=https://your-backend-domain.com
VITE_CLOUD_ENDPOINT=/faceSwapAction
VITE_CLOUD_TIMEOUT_MS=20000
VITE_CLOUD_TASK_POLL_INTERVAL_MS=2000
VITE_CLOUD_TASK_POLL_ATTEMPTS=25
VITE_CLOUD_RETRY_COUNT=2

# 若后端把结果图嵌套在特定字段，用点路径指定，例如 data.output.image_url
VITE_CLOUD_RESULT_PATH=


# ── 8. Invoker — 微信小程序 WebView 桥（VITE_CLOUD_PROVIDER=invoker） ─────────
#    小程序在 WebView 中注入 window.__XmetaCloudInvoke，无需额外 Key 配置。
#    超时与重试复用 VITE_CLOUD_TIMEOUT_MS / VITE_CLOUD_RETRY_COUNT。
#    （在浏览器中预览时可将 VITE_API_MODE=mock 临时替代此模式）


# ── 9. 兼容 / 旧版配置 ─────────────────────────────────────────────────────────

# 9-1  旧版风格模板 URL（已被 VITE_AI_TEMPLATE_* 取代）
#      仅当 VITE_AI_TEMPLATE_A1 / B1 / C1 均未配置时，换脸客户端才会回退到此处。
VITE_TARGET_URL_A=
VITE_TARGET_URL_B=
VITE_TARGET_URL_C=

# 9-2  旧版 PreStage 直连 PiAPI（仅 /pre-stage 旧页面使用，主流程不依赖）
#      ⚠ API Key 打包进前端 JS，建议仅用于内网测试
VITE_AI_BASE_URL=https://api.piapi.ai
VITE_AI_MODEL=Qubico/image-toolkit
VITE_AI_API_KEY=your_old_prestage_key_here
VITE_AI_POLL_INTERVAL_MS=2000
VITE_AI_POLL_ATTEMPTS=24
