# ─── xmeta-agent-h5 环境变量说明 ──────────────────────────────────────────────
# 复制为 .env.local（不提交到 Git）后填写真实值。
# 说明：所有 VITE_ 前缀变量均会被 Vite 打包进客户端 JS，请勿存放高敏感密钥。
# 生产环境建议使用 backend/invoker 模式，由服务端持有 API Key。

# ── 运行模式 ──────────────────────────────────────────────────────────────────
# mock  → 使用本地 mockFaceSwapClient（无需任何后端，仅做界面联调）
# cloud → 使用 cloudFaceSwapClient（需配置下方 VITE_CLOUD_PROVIDER）
VITE_APP_MODE=FULL
VITE_API_MODE=mock
VITE_POSE_GUIDE=0
VITE_POSE_GUIDE_DEBUG_NO_CAMERA=0

# ── Cloud Provider（VITE_API_MODE=cloud 时生效） ───────────────────────────────
# invoker → window.__XmetaCloudInvoke（由微信小程序 WebView 注入，无需额外配置）
# backend → HTTP REST 接口（需部署与云函数 faceSwapAction 协议相同的 HTTP 服务）
# piapi   → 直连 PiAPI（⚠️ API Key 会打包进 JS，仅适用于开发/内网环境）
VITE_CLOUD_PROVIDER=invoker

# ── ImgBB 图片上传（backend / invoker / piapi 三种 cloud 模式均需要） ──────────
# 用户图片须先上传至公网才能被 PiAPI face-swap 访问（等价于小程序的 uploadToPublic）
# 免费 Key 申请：https://api.imgbb.com/
VITE_IMGBB_KEY=your_imgbb_api_key_here

# ── 换脸模板图片 URL（对应小程序 PORTAL_TARGET_URLS / p1,p2,p3） ──────────────
# 风格 A/B/C 依次对应小程序的传送门 p1/p2/p3
# 默认使用同一张占位图，正式上线前请替换为各场景的模板图公网 URL
VITE_TARGET_URL_A=https://i.ibb.co/S7KF4FND/generated-1776064061424.jpg
VITE_TARGET_URL_B=https://i.ibb.co/S7KF4FND/generated-1776064061424.jpg
VITE_TARGET_URL_C=https://i.ibb.co/S7KF4FND/generated-1776064061424.jpg

# ── Backend HTTP 模式（VITE_CLOUD_PROVIDER=backend） ──────────────────────────
# 部署一个 HTTP 服务，实现与云函数 faceSwapAction 相同的 submit/poll 协议：
#   POST /faceSwapAction  { action:'submit', swapImageUrl, targetImageUrl }
#                          → { success:true, taskId }
#   POST /faceSwapAction  { action:'poll',   taskId }
#                          → { success:true, status, imageUrl? }
VITE_CLOUD_BASE_URL=https://your-backend-domain.com
VITE_CLOUD_ENDPOINT=/faceSwapAction
VITE_CLOUD_TIMEOUT_MS=20000
VITE_CLOUD_TASK_POLL_INTERVAL_MS=2000
VITE_CLOUD_TASK_POLL_ATTEMPTS=25
# 若后端把结果图嵌套在特定字段，用点路径指定，例如 data.output.image_url
VITE_CLOUD_RESULT_PATH=

# ── PiAPI 直连模式（VITE_CLOUD_PROVIDER=piapi，⚠️ 不推荐生产使用） ─────────────
# 与云函数 faceSwapAction 内部调用 PiAPI 的参数完全对应
VITE_PIAPI_BASE_URL=https://api.piapi.ai
VITE_PIAPI_ENDPOINT=/api/v1/task
VITE_PIAPI_MODEL=Qubico/image-toolkit
VITE_PIAPI_API_KEY=your_piapi_key_here
# 若 PiAPI 返回结构变更，通过此路径指定结果图字段，例如 output.image_url
VITE_PIAPI_RESULT_PATH=

# ── Invoker 重试（VITE_CLOUD_PROVIDER=invoker） ───────────────────────────────
VITE_CLOUD_RETRY_COUNT=2

# ── PreStageV2 直连 AI（仅开发验证，生产请改后端代调）──────────────────────────
# ⚠️ VITE_ 变量会被打包到前端，任何人都可在浏览器中看到，不要放生产主密钥。
# 建议：仅使用受限/临时 Key，且配置额度和来源限制。
VITE_AI_BASE_URL=https://api.piapi.ai
VITE_AI_MODEL=Qubico/image-toolkit
VITE_AI_API_KEY=your_piapi_limited_key_here
VITE_AI_POLL_INTERVAL_MS=2000
VITE_AI_POLL_ATTEMPTS=24
